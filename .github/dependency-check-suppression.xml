<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

  <!--
    Supresiones de OWASP Dependency-Check para spring-petclinic 2.6.0-SNAPSHOT.

    Contexto: el proyecto esta anclado a Spring Boot 2.6.x sobre Java 8, cuyo tren de
    dependencias ya no recibe parches de seguridad. Las CVEs suprimidas aqui son reales
    y no estan mitigadas; se suprimen para que el gate de SCA siga siendo util frente a
    dependencias nuevas en lugar de estar permanentemente en rojo.

    Cada bloque fija el artefacto Y su version en el filePath, anclado al final de la
    ruta: al subir cualquiera de estas dependencias la supresion deja de aplicar
    automaticamente y las CVEs de la version nueva vuelven a evaluarse.

    El atributo "until" hace que estas supresiones expiren el 2027-02-10. A partir de
    esa fecha el gate vuelve a fallar, lo que fuerza una revision explicita.

    ULTIMA REVISION: 2026-08-10
  -->

  <!-- El jar de la aplicacion, emparejado por CPE contra spring_boot 2.6.0.
       El ancle final es importante: sin el, el regex tambien cubriria las rutas
       anidadas BOOT-INF/lib/*.jar y suprimiria el scan completo. -->
  <suppress until="2027-02-10Z">
    <notes>spring-petclinic 2.6.0-SNAPSHOT. CVEs del framework Spring Boot 2.6.x.</notes>
    <filePath regex="true">.*[\\/]spring-petclinic-2\.6\.0-SNAPSHOT\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <!-- Tomcat embebido. core y websocket comparten el CPE apache:tomcat:9.0.60. -->
  <suppress until="2027-02-10Z">
    <notes>tomcat-embed-core 9.0.60 (Spring Boot 2.6.6). Sin parches para la rama 9.0.60.</notes>
    <filePath regex="true">.*[\\/]tomcat-embed-core-9\.0\.60\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <suppress until="2027-02-10Z">
    <notes>tomcat-embed-websocket 9.0.60. Mismo CPE que tomcat-embed-core.</notes>
    <filePath regex="true">.*[\\/]tomcat-embed-websocket-9\.0\.60\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <!-- Spring Framework. -->
  <suppress until="2027-02-10Z">
    <notes>spring-core 5.3.18 (Spring Boot 2.6.6). Requiere migrar a Spring Framework 6 / Java 17.</notes>
    <filePath regex="true">.*[\\/]spring-core-5\.3\.18\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <!-- Thymeleaf. Los tres jars comparten el CPE thymeleaf:thymeleaf. -->
  <suppress until="2027-02-10Z">
    <notes>thymeleaf 3.0.15.RELEASE (Spring Boot 2.6.6).</notes>
    <filePath regex="true">.*[\\/]thymeleaf-3\.0\.15\.RELEASE\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <suppress until="2027-02-10Z">
    <notes>thymeleaf-spring5 3.0.15.RELEASE. Hereda el CPE de thymeleaf.</notes>
    <filePath regex="true">.*[\\/]thymeleaf-spring5-3\.0\.15\.RELEASE\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <suppress until="2027-02-10Z">
    <notes>thymeleaf-extras-java8time 3.0.4.RELEASE. Hereda el CPE de thymeleaf.</notes>
    <filePath regex="true">.*[\\/]thymeleaf-extras-java8time-3\.0\.4\.RELEASE\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <!-- Logging: logback y el puente log4j-to-slf4j. -->
  <suppress until="2027-02-10Z">
    <notes>logback-core 1.2.11 (transitiva de spring-boot-starter-logging).</notes>
    <filePath regex="true">.*[\\/]logback-core-1\.2\.11\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <suppress until="2027-02-10Z">
    <notes>logback-classic 1.2.11. Mismo CPE que logback-core.</notes>
    <filePath regex="true">.*[\\/]logback-classic-1\.2\.11\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <suppress until="2027-02-10Z">
    <notes>log4j-api 2.17.2 (solo el api, via log4j-to-slf4j; no se usa el core).</notes>
    <filePath regex="true">.*[\\/]log4j-api-2\.17\.2\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <suppress until="2027-02-10Z">
    <notes>log4j-to-slf4j 2.17.2. Puente hacia logback; emparejado por el CPE apache:log4j.</notes>
    <filePath regex="true">.*[\\/]log4j-to-slf4j-2\.17\.2\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <!-- Serializacion. -->
  <suppress until="2027-02-10Z">
    <notes>snakeyaml 1.29 (transitiva de spring-boot-starter). CVE-2022-1471 y familia.</notes>
    <filePath regex="true">.*[\\/]snakeyaml-1\.29\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <suppress until="2027-02-10Z">
    <notes>jackson-databind 2.13.2.2 (transitiva de spring-boot-starter-json).</notes>
    <filePath regex="true">.*[\\/]jackson-databind-2\.13\.2\.2\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <!-- Drivers de base de datos. -->
  <suppress until="2027-02-10Z">
    <notes>h2 1.4.200. Base de datos en memoria, solo para desarrollo y tests.</notes>
    <filePath regex="true">.*[\\/]h2-1\.4\.200\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

  <suppress until="2027-02-10Z">
    <notes>postgresql 42.3.3. Driver JDBC, solo se usa con el perfil de PostgreSQL.</notes>
    <filePath regex="true">.*[\\/]postgresql-42\.3\.3\.jar$</filePath>
    <vulnerabilityName regex="true">.*</vulnerabilityName>
  </suppress>

</suppressions>
